#!/bin/zsh

# Builds Evie.app from the SwiftPM product.
#
# This exists because a bare SwiftPM executable cannot ask for the microphone. It
# is not that the request fails — measured on this Mac, touching
# `AVAudioEngine().inputNode` from an unbundled binary hangs the main thread
# indefinitely inside coreaudiod, because TCC identifies the process by executable
# name, attributes the request to the terminal that launched it, and finds no
# usage description to put in a dialog. Nothing about voice can be built until
# Evie has a bundle identity.

set -euo pipefail

readonly EVIE_BUNDLE_ID="com.matheusbgodoi.evie"
readonly EVIE_APP_NAME="Evie"
readonly EVIE_EXECUTABLE="evie-shell"
readonly EVIE_SHORT_VERSION="2.0.0"
readonly EVIE_NATIVE_APPLE_MODE="${EVIE_NATIVE_APPLE_MODE:-public-urls}"
readonly EVIE_SIGNING_IDENTITY_NAME="Evie Dev"
# The one certificate every TCC grant and every update check on this Mac is tied
# to, by SHA-1 rather than by name. A name is not an identity: a second
# certificate called "Evie Dev" — an old one never deleted, or one somebody else
# imported — would make `codesign --sign "Evie Dev"` ambiguous at best and sign
# with the wrong key at worst, and either way every permission would be granted
# to a stranger. Changing this value is a deliberate act with a cost: see
# `identity` below and "Signing" in docs/MACOS_RUNTIME.md.
readonly EVIE_SIGNING_IDENTITY_SHA1="E1CDAAB36B6D3B8B6FEB3E7D46BA020120524C9E"

readonly EVIE_SCRIPT_DIR="${0:A:h}"
readonly EVIE_REPOSITORY_DIR="${EVIE_SCRIPT_DIR:h}"
readonly EVIE_BUILD_DIR="${EVIE_REPOSITORY_DIR}/.build/release"
readonly EVIE_APP_DIR="${EVIE_BUILD_DIR}/${EVIE_APP_NAME}.app"
readonly EVIE_INSTALL_DIR="${EVIE_INSTALL_DIR_OVERRIDE:-${HOME}/Applications}"
readonly EVIE_INSTALLED_APP="${EVIE_INSTALL_DIR}/${EVIE_APP_NAME}.app"
# Evie's own keychain item for the PC gateway's key, and the one the PC stack's
# setup wrote on this Mac. Must match `EvieModelProfile.builtInPC.credential`
# and `EvieModelKeys.pcConfigurationItem`.
readonly EVIE_MODEL_KEY_SERVICE="com.matheusbgodoi.evie.model"
readonly EVIE_MODEL_KEY_ACCOUNT="pc-3090"
readonly EVIE_MODEL_KEY_HOST="models.example.invalid"
readonly PC_CONFIGURATION_KEY_SERVICE="local-ai-3090"
readonly PC_CONFIGURATION_KEY_ACCOUNT="gateway-api-key"

function usage() {
  print "Usage: Scripts/evie-app <build|identity|install|run|status|uninstall|import-pc-key>"
  print ""
  print "  build      Compile release, assemble ${EVIE_APP_NAME}.app in .build/release, and"
  print "             sign it with the pinned '${EVIE_SIGNING_IDENTITY_NAME}' certificate"
  print "  identity   Create a self-signed code-signing certificate so macOS keeps"
  print "             granted permissions across rebuilds"
  print "  install    Copy the bundle to ${EVIE_INSTALLED_APP} and open it"
  print "  run        Launch the installed bundle the way TCC requires"
  print "  status     Report bundle, signature, and permission state"
  print "  uninstall  Remove the installed bundle"
  print "  import-pc-key"
  print "             Copy the PC gateway key from ${PC_CONFIGURATION_KEY_SERVICE} into Evie's own"
  print "             keychain item, readable by the installed bundle only"
}

# The SHA-1 of every valid code-signing identity whose name is exactly
# "Evie Dev", one per line.
function named_identity_hashes() {
  # Read, then match. Piping into `grep -q` under `set -o pipefail` can report
  # the pipeline as failed even on a match — grep exits at the first hit and the
  # writer dies of SIGPIPE. The same pattern made Scripts/evie-release refuse
  # every bundle it was ever given.
  local identities line
  identities=$(security find-identity -v -p codesigning 2>/dev/null || true)
  for line in "${(@f)identities}"; do
    # `  1) E1CDAAB36B6D3B8B6FEB3E7D46BA020120524C9E "Evie Dev"`
    if [[ "${line}" =~ '^ *[0-9]+\) ([0-9A-F]{40}) "(.*)"$' ]] \
      && [[ "${match[2]}" == "${EVIE_SIGNING_IDENTITY_NAME}" ]]; then
      print -r -- "${match[1]}"
    fi
  done
}

# Prints the pinned SHA-1 when that certificate is a valid signing identity in
# the keychain, and fails otherwise. Never falls back to ad-hoc.
function signing_identity() {
  # A self-signed certificate gives a stable designated requirement, which is what
  # lets TCC prove build N+1 is the same code as build N. Ad-hoc signatures have
  # no stable requirement, so every rebuild loses every grant — which is why an
  # absent certificate is now a failed build rather than a quiet ad-hoc one.
  local -a hashes
  hashes=(${(f)"$(named_identity_hashes)"})
  if (( ${hashes[(Ie)${EVIE_SIGNING_IDENTITY_SHA1}]} )); then
    print -r -- "${EVIE_SIGNING_IDENTITY_SHA1}"
    return 0
  fi
  return 1
}

function explain_missing_identity() {
  local -a hashes
  hashes=(${(f)"$(named_identity_hashes)"})
  print -u2 ""
  if (( ${#hashes} == 0 )); then
    print -u2 "No valid '${EVIE_SIGNING_IDENTITY_NAME}' signing identity is in the keychain."
    print -u2 "Run 'Scripts/evie-app identity' to create one."
  else
    print -u2 "The keychain has '${EVIE_SIGNING_IDENTITY_NAME}' as ${hashes[*]},"
    print -u2 "but this script is pinned to ${EVIE_SIGNING_IDENTITY_SHA1}."
    print -u2 "Signing with another certificate makes every permission and every update"
    print -u2 "check treat Evie as a different application. If the certificate really was"
    print -u2 "replaced, change EVIE_SIGNING_IDENTITY_SHA1 here on purpose and commit it."
  fi
}

# Fails unless the bundle's seal holds and its designated requirement is the one
# TCC grants are attached to: this bundle identifier, and this certificate.
#
# The requirement is what TCC compares on every launch. Asserted here because a
# signature that verifies is not necessarily the right signature: an ad-hoc
# seal verifies perfectly, and so does one made with any other certificate.
function verify_signature() {
  local bundle="$1"
  codesign --verify --deep --strict "${bundle}"

  local description designated=""
  description=$(codesign -d -r- "${bundle}" 2>&1)
  local line
  for line in "${(@f)description}"; do
    if [[ "${line}" == "designated => "* ]]; then
      designated="${line}"
    fi
  done

  # A self-signed certificate is its own leaf, and codesign writes the hash in
  # lower case: `designated => identifier "…" and certificate leaf = H"e1cd…"`.
  local expected_identifier="identifier \"${EVIE_BUNDLE_ID}\""
  local expected_certificate="certificate leaf = H\"${(L)EVIE_SIGNING_IDENTITY_SHA1}\""
  if [[ "${designated}" != *"${expected_identifier}"* \
    || "${designated}" != *"${expected_certificate}"* ]]; then
    print -u2 "The designated requirement of ${bundle} is not Evie's:"
    print -u2 -- "${description}"
    print -u2 "Expected ${expected_identifier} and ${expected_certificate}."
    return 1
  fi
}

# Validate the actual candidate, including when install is invoked after a
# failed build. Run before stopping the current app or replacing any bundle.
function verify_native_mode() {
  local bundle="$1" native_mode native_signature
  if ! native_mode=$(/usr/bin/plutil -extract EvieNativeAppleMode raw "${bundle}/Contents/Info.plist" 2>/dev/null); then
    print -u2 "Native Apple mode is missing. Rebuild before installing."
    return 1
  fi
  case "${native_mode}" in
    public-urls)
      if [[ -e "${bundle}/Contents/Resources/Metadata.appintents" ]]; then
        print -u2 "Public URL mode must not publish unsupported direct App Intents."
        return 1
      fi
      ;;
    app-intents)
      # The stable self-signed TCC identity cannot authenticate to linkd.
      # Neither a fabricated entitlement nor a certificate OU is sufficient.
      if ! codesign --verify --strict -R='anchor apple generic' "${bundle}"; then
        print -u2 "Direct App Intents require an Apple-issued signing identity."
        return 1
      fi
      native_signature=$(codesign -dv --verbose=4 "${bundle}" 2>&1)
      if ! print -r -- "${native_signature}" | /usr/bin/grep -Eq '^TeamIdentifier=[A-Za-z0-9]+$'; then
        print -u2 "Direct App Intents require a real Apple Team Identifier."
        return 1
      fi
      ;;
    *) print -u2 "Unsupported Native Apple mode in candidate bundle."; return 1 ;;
  esac
}

function build() {
  # Before compiling, not after: a missing certificate is a two-minute build
  # thrown away otherwise.
  local identity
  if ! identity=$(signing_identity); then
    explain_missing_identity
    return 1
  fi

  print "Building the release executable…"
  local -a native_swift_flags=()
  case "${EVIE_NATIVE_APPLE_MODE}" in
    public-urls) ;;
    app-intents) native_swift_flags=(-Xswiftc -DEVIE_DIRECT_APP_INTENTS) ;;
    *) print -u2 "EVIE_NATIVE_APPLE_MODE must be public-urls or app-intents."; return 1 ;;
  esac
  swift build -c release --product "${EVIE_EXECUTABLE}" \
    --package-path "${EVIE_REPOSITORY_DIR}" \
    -Xswiftc -warnings-as-errors "${native_swift_flags[@]}"

  local executable="${EVIE_BUILD_DIR}/${EVIE_EXECUTABLE}"
  if [[ ! -x "${executable}" ]]; then
    print -u2 "Release executable is missing: ${executable}"
    return 1
  fi

  rm -rf "${EVIE_APP_DIR}"
  mkdir -p "${EVIE_APP_DIR}/Contents/MacOS" "${EVIE_APP_DIR}/Contents/Resources"

  if [[ ! -f "${EVIE_REPOSITORY_DIR}/Resources/Evie.icns" ]]; then
    print "Desenhando o ícone…"
    "${EVIE_SCRIPT_DIR}/evie-icon" >/dev/null
  fi
  cp "${EVIE_REPOSITORY_DIR}/Resources/Evie.icns" "${EVIE_APP_DIR}/Contents/Resources/Evie.icns"
  cp "${executable}" "${EVIE_APP_DIR}/Contents/MacOS/${EVIE_EXECUTABLE}"

  # SwiftPM emits resource bundles beside the executable. Missing them breaks
  # `Bundle.module` at runtime rather than at build time, so copy whatever exists.
  local bundle
  for bundle in "${EVIE_BUILD_DIR}"/*.bundle(N); do
    cp -R "${bundle}" "${EVIE_APP_DIR}/Contents/Resources/"
    print "Bundled resource: ${bundle:t}"
  done

  write_info_plist
  plutil -lint -s "${EVIE_APP_DIR}/Contents/Info.plist"

  # SwiftPM does not extract direct App Intents metadata. The optional
  # Apple-signed mode needs that resource; public URL mode removes stale metadata.
  "${EVIE_SCRIPT_DIR}/evie-native-metadata" "${EVIE_APP_DIR}" "${EVIE_NATIVE_APPLE_MODE}"

  # No sandbox and no hardened runtime, on purpose: reading the accessibility
  # tree and posting input events both need the sandbox off, and nothing here
  # needs the hardened runtime's protections to obtain a grant.
  #
  # Errors are not discarded. This line used to end in `>/dev/null 2>&1`, so a
  # locked keychain or a refused key was indistinguishable from success until
  # something downstream failed for a reason nobody could see.
  codesign --force --sign "${identity}" \
    --identifier "${EVIE_BUNDLE_ID}" \
    "${EVIE_APP_DIR}"
  verify_signature "${EVIE_APP_DIR}"
  verify_native_mode "${EVIE_APP_DIR}"

  print "Signed with ${EVIE_SIGNING_IDENTITY_NAME} (${identity})."
  print "Built ${EVIE_APP_DIR}"
}

function write_info_plist() {
  cat > "${EVIE_APP_DIR}/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>pt_BR</string>
  <key>CFBundleExecutable</key>
  <string>${EVIE_EXECUTABLE}</string>
  <key>CFBundleIdentifier</key>
  <string>${EVIE_BUNDLE_ID}</string>
  <key>CFBundleName</key>
  <string>${EVIE_APP_NAME}</string>
  <key>CFBundleIconFile</key>
  <string>Evie</string>
  <key>CFBundleDisplayName</key>
  <string>${EVIE_APP_NAME}</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>${EVIE_SHORT_VERSION}</string>
  <key>CFBundleVersion</key>
  <string>${EVIE_SHORT_VERSION}</string>
  <key>LSMinimumSystemVersion</key>
  <string>26.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>EvieNativeAppleMode</key>
  <string>${EVIE_NATIVE_APPLE_MODE}</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>${EVIE_BUNDLE_ID}.review</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array><string>evie</string></array>
    </dict>
  </array>
  <key>NSHumanReadableCopyright</key>
  <string>Uso pessoal de Matheus Barboza de Godoi.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>A Evie usa o microfone para ouvir a palavra de ativação quando essa opção está ligada e transcrever sua fala neste Mac. O áudio não é enviado ao cérebro nem guardado por padrão.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>A Evie transcreve sua fala localmente, neste Mac.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>A Evie vê sua tela só quando você pede, para responder sobre ela ou agir por você.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>A Evie lê arquivos da Mesa apenas nas pastas que você autorizar.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>A Evie lê seus documentos apenas nas pastas que você autorizar.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>A Evie lê a pasta Downloads apenas quando você autorizar.</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>A Evie lê o Mail e o Calendário deste Mac: remetente, assunto, data e o começo do texto das mensagens, e seus compromissos entre duas datas. Ela também pode criar um compromisso na agenda e enviar um e-mail — as duas coisas só acontecem depois de você ver na tela para quem, de qual conta e o texto inteiro, e apertar o botão. Ela não apaga, não arquiva e não marca mensagem como lida.</string>
</dict>
</plist>
PLIST
}

function identity() {
  local -a existing
  existing=(${(f)"$(named_identity_hashes)"})
  if (( ${#existing} > 0 )); then
    print "The '${EVIE_SIGNING_IDENTITY_NAME}' certificate already exists: ${existing[*]}"
    if ! signing_identity >/dev/null; then
      explain_missing_identity
      return 1
    fi
    return 0
  fi

  local work_dir
  work_dir=$(mktemp -d)
  # The directory holds an unencrypted private key and its p12. Under `set -e` a
  # failed import, or a trust prompt the person cancels, ends the script before
  # the `rm -rf` below; in zsh an EXIT trap set in a function runs when the
  # function ends, by return or by error, so the key never outlives this step.
  trap 'rm -rf "${work_dir}"' EXIT
  print "Creating a self-signed code-signing certificate…"

  # Errors are not discarded here, and that is the point. This step used to send
  # both openssl invocations to /dev/null, so when `-legacy` turned out not to
  # exist in the LibreSSL that macOS ships, the p12 was simply never written and
  # the import failed against a missing file — silently. Evie stayed ad-hoc
  # signed for weeks, which meant no stable identity, permissions re-granted on
  # every rebuild, and nothing for an update to be checked against.
  #
  # `/usr/bin/openssl` by absolute path, because the `openssl` on PATH is
  # whichever one is first. Measured on 2026-10-16 (macOS 27.2): a p12 exported
  # by Homebrew's OpenSSL 3.6.4 is refused by `security import` with "MAC
  # verification failed during PKCS12 import", because OpenSSL 3 encrypts with
  # AES-256 and PBKDF2 by default; the same commands through the system's
  # LibreSSL 3.3.6 import cleanly. With Homebrew first on PATH this step would
  # have failed again, this time loudly but just as uselessly.
  /usr/bin/openssl req -x509 -newkey rsa:2048 -days 3650 -nodes \
    -keyout "${work_dir}/dev.key" -out "${work_dir}/dev.crt" \
    -subj "/CN=${EVIE_SIGNING_IDENTITY_NAME}" \
    -addext "keyUsage=critical,digitalSignature" \
    -addext "extendedKeyUsage=codeSigning"
  /usr/bin/openssl pkcs12 -export \
    -in "${work_dir}/dev.crt" -inkey "${work_dir}/dev.key" \
    -out "${work_dir}/dev.p12" -password pass:evie

  security import "${work_dir}/dev.p12" \
    -k "${HOME}/Library/Keychains/login.keychain-db" \
    -P evie -T /usr/bin/codesign

  # An imported certificate is not yet a usable signing identity: codesign wants
  # it trusted for that purpose. This was documented as a manual trip through
  # Keychain Access, which it does not have to be — the trust setting can be
  # written to the user's own domain. macOS asks for authorisation once.
  print ""
  print "macOS will ask permission to trust the certificate for code signing."
  security add-trusted-cert -r trustRoot -p codeSign \
    -k "${HOME}/Library/Keychains/login.keychain-db" "${work_dir}/dev.crt"

  rm -rf "${work_dir}"

  # Asserted rather than assumed. Every failure above was a silent one.
  local -a created
  created=(${(f)"$(named_identity_hashes)"})
  if (( ${#created} == 0 )); then
    print -u2 ""
    print -u2 "The certificate was created but is still not a valid signing identity."
    print -u2 "Open Keychain Access, find '${EVIE_SIGNING_IDENTITY_NAME}' under login,"
    print -u2 "and set Get Info -> Trust -> Code Signing to Always Trust."
    return 1
  fi

  print ""
  print "Created ${EVIE_SIGNING_IDENTITY_NAME} with SHA-1 ${created[1]}."
  print ""
  print "This script signs only with the pinned certificate, ${EVIE_SIGNING_IDENTITY_SHA1}."
  print "To build with the new one, set EVIE_SIGNING_IDENTITY_SHA1 at the top of"
  print "Scripts/evie-app to ${created[1]} and commit that change. It is a new"
  print "identity to macOS: every permission has to be granted again, and copies"
  print "signed with the old certificate will refuse updates signed with this one."
  print ""
  print "This is not a Developer ID. It keeps permissions across rebuilds on this"
  print "Mac and nowhere else; it does not pass Gatekeeper on another machine."
  print "It is also what an update is checked against: Evie only installs a"
  print "download signed by this same certificate."
}

# Stops every running Evie and waits for it to be gone.
#
# The wait is what makes the launch that follows a launch. `open` on an
# application that is still running only activates it, so a copy that was
# sent SIGTERM and has not exited yet would swallow the new launch and the old
# build would keep running.
function stop_running_copies() {
  pkill -f "${EVIE_APP_NAME}.app/Contents/MacOS/${EVIE_EXECUTABLE}" 2>/dev/null || true
  pkill -f "${EVIE_BUILD_DIR}/${EVIE_EXECUTABLE}" 2>/dev/null || true
  local attempt
  for attempt in {1..50}; do
    if ! pgrep -f "${EVIE_APP_NAME}.app/Contents/MacOS/${EVIE_EXECUTABLE}" >/dev/null 2>&1 \
      && ! pgrep -f "${EVIE_BUILD_DIR}/${EVIE_EXECUTABLE}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  print -u2 "Evie did not quit within 5 seconds; quit it from the menu bar and retry."
  return 1
}

# Launch through Launch Services, never by running the executable directly.
# Measured: starting the binary from a terminal makes TCC attribute the request
# to the terminal, so the microphone permission is granted to the wrong
# application and Evie never receives it.
function open_installed() {
  open "${EVIE_INSTALLED_APP}"
  print "Launched ${EVIE_INSTALLED_APP}"
}

# Installs into ~/Applications and opens that copy.
#
# Permissions are granted to the installed copy only. The bundle in .build is
# rebuilt and deleted constantly, and two registered bundles with one identifier
# leave Launch Services free to open either; one stable path is what makes a
# grant in System Settings name the application the user actually runs.
function install_app() {
  if [[ ! -d "${EVIE_APP_DIR}" ]]; then
    print -u2 "Nothing built yet. Run 'Scripts/evie-app build' first."
    return 1
  fi
  # Refused before anything is replaced: installing a bundle TCC would not
  # recognise loses every grant the installed copy holds.
  verify_signature "${EVIE_APP_DIR}"
  verify_native_mode "${EVIE_APP_DIR}"

  stop_running_copies
  mkdir -p "${EVIE_INSTALL_DIR}"
  rm -rf "${EVIE_INSTALLED_APP}"
  # ditto, not cp: it carries the extended attributes and symlink structure the
  # signature was computed over.
  ditto "${EVIE_APP_DIR}" "${EVIE_INSTALLED_APP}"
  verify_signature "${EVIE_INSTALLED_APP}"
  print "Installed ${EVIE_INSTALLED_APP}"

  open_installed
}

function run_app() {
  if [[ ! -d "${EVIE_INSTALLED_APP}" ]]; then
    print -u2 "Evie is not installed at ${EVIE_INSTALLED_APP}."
    print -u2 "Run 'Scripts/evie-app build' and 'Scripts/evie-app install'. The copy in"
    print -u2 ".build is never launched, so no permission is ever granted to it."
    return 1
  fi

  stop_running_copies
  open_installed
}

function status() {
  print "Bundle identifier: ${EVIE_BUNDLE_ID}"

  local target="${EVIE_INSTALLED_APP}"
  [[ -d "${target}" ]] || target="${EVIE_APP_DIR}"
  if [[ ! -d "${target}" ]]; then
    print "Bundle: not built"
  else
    print "Bundle: ${target}"
    local signature
    signature=$(codesign -dv --verbose=2 "${target}" 2>&1 || true)
    print "Signature: $(print -r -- "${signature}" | grep -E '^(Signature|TeamIdentifier)' | tr '\n' ' ')"
    if [[ "${signature}" == *adhoc* ]]; then
      print "  Ad-hoc: macOS will re-ask for permissions after each rebuild."
    fi
    if verify_signature "${target}" >/dev/null 2>&1; then
      print "Designated requirement: Evie's (${EVIE_BUNDLE_ID}, pinned certificate)"
    else
      print "Designated requirement: NOT Evie's — TCC treats this copy as a stranger"
    fi
  fi

  if signing_identity >/dev/null; then
    print "Signing identity: ${EVIE_SIGNING_IDENTITY_NAME} (${EVIE_SIGNING_IDENTITY_SHA1})"
  else
    print "Signing identity: pinned certificate missing (run 'Scripts/evie-app identity')"
  fi

  if pgrep -f "${EVIE_APP_NAME}.app/Contents/MacOS/${EVIE_EXECUTABLE}" >/dev/null 2>&1; then
    print "Running: yes (bundled)"
  elif pgrep -f "${EVIE_BUILD_DIR}/${EVIE_EXECUTABLE}" >/dev/null 2>&1; then
    print "Running: yes (unbundled — cannot obtain the microphone)"
  else
    print "Running: no"
  fi
}

function uninstall_app() {
  if [[ -d "${EVIE_INSTALLED_APP}" ]]; then
    pkill -f "${EVIE_APP_NAME}.app/Contents/MacOS/${EVIE_EXECUTABLE}" 2>/dev/null || true
    rm -rf "${EVIE_INSTALLED_APP}"
    print "Removed ${EVIE_INSTALLED_APP}"
  else
    print "Nothing installed at ${EVIE_INSTALLED_APP}"
  fi
  print ""
  print "Permissions granted to ${EVIE_BUNDLE_ID} remain in System Settings ->"
  print "Privacy & Security. Remove them there, or with"
  print "'tccutil reset All ${EVIE_BUNDLE_ID}', if you want a clean slate."
}

# Copies the PC gateway's key from the PC configuration's keychain item into
# Evie's own, the same copy Configurações › Cérebro › "Importar da configuração
# do PC" makes, for a Mac set up from a terminal.
#
# The key never appears in an argument list, where any process could read it
# for as long as the command runs (`ps -o args`). It is read into a variable,
# checked, and written to `security add-generic-password` through a pipe: `-w`
# given last with no value makes `security` read the password from stdin, once
# and then again to confirm it (verified 2026-10-16 on macOS 27.2 with a
# throwaway item). `print` and `printf` are shell builtins, so nothing is exec'd
# with the key either. It is never printed.
#
# `-T` names the installed bundle as the one program allowed to read the item
# without asking — not `security`, not this script, and not the copy in .build,
# which is rebuilt and deleted constantly.
#
# The item under Evie's name is deleted first and the add has no `-U`: `-U`
# updates an existing item in place, keeping its access list, so an item that
# another program made first under this name ("squatting" it, readable by that
# program) would be handed the key. A delete that fails for any reason but "no
# such item" (44) stops the import, and so does an add that finds the item back
# (45).
function import_pc_key() {
  if [[ ! -d "${EVIE_INSTALLED_APP}" ]]; then
    print -u2 "Evie is not installed at ${EVIE_INSTALLED_APP}, and the key is tied to that copy."
    print -u2 "Run 'Scripts/evie-app build' and 'Scripts/evie-app install' first."
    return 1
  fi

  local key
  # One read. macOS may ask before handing another program's item to
  # `security`; "Permitir" is enough, since it is read only this once.
  if ! key=$(security find-generic-password \
    -s "${PC_CONFIGURATION_KEY_SERVICE}" -a "${PC_CONFIGURATION_KEY_ACCOUNT}" -w 2>/dev/null); then
    print -u2 "No ${PC_CONFIGURATION_KEY_SERVICE} / ${PC_CONFIGURATION_KEY_ACCOUNT} item in the keychain,"
    print -u2 "or macOS did not allow reading it. Paste the key in Configurações › Cérebro instead."
    return 1
  fi
  # Like the app's own check: one printable token, no spaces, one line.
  if [[ -z "${key}" || "${key}" == *[^[:graph:]]* ]]; then
    key=""
    print -u2 "The ${PC_CONFIGURATION_KEY_SERVICE} item does not hold a single-line key; nothing was saved."
    return 1
  fi

  local deleted=0
  security delete-generic-password \
    -s "${EVIE_MODEL_KEY_SERVICE}" -a "${EVIE_MODEL_KEY_ACCOUNT}" >/dev/null 2>&1 || deleted=$?
  if (( deleted != 0 && deleted != 44 )); then
    key=""
    print -u2 "Could not remove the existing ${EVIE_MODEL_KEY_SERVICE} / ${EVIE_MODEL_KEY_ACCOUNT} item"
    print -u2 "(security exited ${deleted}); nothing was saved. Delete it in Keychain Access and retry."
    return 1
  fi

  if ! printf '%s\n%s\n' "${key}" "${key}" | security add-generic-password \
    -s "${EVIE_MODEL_KEY_SERVICE}" -a "${EVIE_MODEL_KEY_ACCOUNT}" \
    -l "Evie — chave do modelo (${EVIE_MODEL_KEY_HOST})" \
    -T "${EVIE_INSTALLED_APP}" -w >/dev/null; then
    key=""
    print -u2 "Could not create the ${EVIE_MODEL_KEY_SERVICE} / ${EVIE_MODEL_KEY_ACCOUNT} item"
    print -u2 "(another program may have made it again); nothing was saved."
    return 1
  fi
  key=""

  print "Saved the PC key as ${EVIE_MODEL_KEY_SERVICE} / ${EVIE_MODEL_KEY_ACCOUNT}, readable by"
  print "${EVIE_INSTALLED_APP}. If Evie is open, the next question uses it."
}

case "${1:-}" in
  build) build ;;
  identity) identity ;;
  install) install_app ;;
  run) run_app ;;
  status) status ;;
  uninstall) uninstall_app ;;
  import-pc-key) import_pc_key ;;
  *) usage; exit 1 ;;
esac
