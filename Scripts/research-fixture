#!/bin/zsh
set -euo pipefail

readonly repository="${0:A:h:h}"
readonly fixture_root="$(mktemp -d "${TMPDIR:-/tmp}/evie-research-fixture.XXXXXX")"
readonly fixture_app="${fixture_root}/Evie Research Fixture.app"
mkdir -p "${fixture_app}/Contents/MacOS"
xcrun swiftc -swift-version 6 -warnings-as-errors \
  "${repository}/evals/fixtures/ResearchFixture.swift" \
  -o "${fixture_app}/Contents/MacOS/ResearchFixture"
cat > "${fixture_app}/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.matheusbgodoi.evie.research-fixture</string>
<key>CFBundleName</key><string>Evie Research Fixture</string>
<key>CFBundleExecutable</key><string>ResearchFixture</string>
<key>CFBundlePackageType</key><string>APPL</string>
</dict></plist>
PLIST
codesign --force --sign - "${fixture_app}" >&2
print -r -- "${fixture_app}"
