#!/bin/zsh
# Package the checked-in original Evie artwork at every macOS icon size.
# Artwork/provenance: docs/APPLE_VISUAL_IDENTITY.md. No online generation or
# runtime image processing is needed to rebuild or run the application.
set -euo pipefail

readonly root="${0:A:h:h}"
readonly source="${root}/Resources/Evie-Icon-Source.png"
readonly work="$(mktemp -d)"
readonly iconset="${work}/Evie.iconset"
readonly output="${root}/Resources/Evie.icns"
trap 'rm -rf "${work}"' EXIT

if [[ ! -f "${source}" ]]; then
  print -u2 "Artwork missing: ${source}"
  exit 1
fi
mkdir -p "${iconset}"

# Retina and standard icon entries. sips preserves the source alpha channel.
for spec in "16 16x16" "32 16x16@2x" "32 32x32" "64 32x32@2x" \
            "128 128x128" "256 128x128@2x" "256 256x256" "512 256x256@2x" \
            "512 512x512" "1024 512x512@2x"; do
  pixels="${spec%% *}"
  name="${spec##* }"
  sips --resampleHeightWidth "${pixels}" "${pixels}" "${source}" \
    --out "${iconset}/icon_${name}.png" >/dev/null
done
iconutil --convert icns --output "${output}" "${iconset}"
print "Ícone em ${output}"
