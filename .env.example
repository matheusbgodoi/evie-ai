# Implemented non-secret model overrides. These take precedence over
# ~/Library/Application Support/Evie/config.json and built-in defaults.
# Real secrets belong in macOS Keychain or a local, ignored runtime file.

EVIE_MODEL_ENDPOINT=http://127.0.0.1:8080/v1
EVIE_MODEL_NAME=gemma-4-26b-a4b-it
EVIE_MODEL_CONTEXT=65536
EVIE_MODEL_MAX_COMPLETION=4096
EVIE_MODEL_TEMPERATURE=0.2
EVIE_MODEL_TOP_P=0.95
EVIE_MODEL_TIMEOUT_SECONDS=300

# Reserved planning examples below are not loaded by the current shell. Never put
# real credentials in this tracked file.
EVIE_PROFILE=personal
EVIE_LOG_LEVEL=info
GOOGLE_OAUTH_CLIENT_FILE=/absolute/local/path/outside/repository/client.json
WHATSAPP_SESSION_DIR=/absolute/local/path/outside/repository/whatsapp-session
OMNIVOICE_REFERENCE_AUDIO=/absolute/local/path/outside/repository/evie-reference.wav
